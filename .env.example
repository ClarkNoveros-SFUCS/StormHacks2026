# Copy to .env.local and fill in. Never commit real values.
# How to get each one: docs/setup/

# Clerk (F01): dashboard.clerk.com → API keys. Without these every page returns a 500.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tiger Data (F01): docs/setup/tiger-data.md
# Format: postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Snowflake (F03): docs/setup/snowflake.md
# SNOWFLAKE_PRIVATE_KEY is the .p8 file contents in double quotes, with newlines written as \n
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_STAGE=

# Gemini (F04): docs/setup/README.md
GEMINI_API_KEY=
GEMINI_MODEL=
