# Copy to .env.local and fill in. Never commit real values.
# How to get each one: docs/setup/

# Clerk (F01): `clerk env pull` (Clerk CLI) or dashboard.clerk.com → API keys.
# Without the keys every page returns a 500.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Tiger Data (F01): docs/setup/tiger-data.md
# Format: postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Tests (F07): DB integration tests run only when this is set in the shell (Vitest doesn't
# read .env.local). Use a local TimescaleDB, never the shared Tiger service: setup steps in
# lib/progress.test.ts. Example:
#   TEST_DATABASE_URL=postgres://postgres:test@localhost:5499/stormhacks_test npm test

# Snowflake (F03): docs/setup/snowflake.md
# SNOWFLAKE_PRIVATE_KEY is the .p8 file contents in double quotes, with newlines written as \n
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_STAGE=

# Gemini (F04): docs/setup/README.md
GEMINI_API_KEY=
GEMINI_MODEL=
