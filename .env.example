# Copy to .env.local and fill in. Never commit real values.
# How to get each one: docs/setup/

# Clerk (F01): `clerk env pull` (Clerk CLI) or dashboard.clerk.com → API keys.
# Without the keys every page returns a 500.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Tiger Data (F01): docs/setup/tiger-data.md
# Format: postgres://tsdbadmin:<password>@<service-id>.<project-id>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# Gemini (F04): docs/setup/README.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: used only when GEMINI_MODEL is still overloaded (503) after retries.
# Lite is weaker (fewer Open Prompts) but rarely overloaded, so a Game still gets made.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional (F16): the verification pass (a second, cheap Gemini call per document that drops
# Answers their page doesn't support, unclear Prompts and duplicates) is on by default; "off"
# skips it. Its model defaults to GEMINI_FALLBACK_MODEL (lite), then GEMINI_MODEL.
GEMINI_VERIFY=
GEMINI_VERIFY_MODEL=
# Optional (F17): "on" asks Gemini for ~25 Prompts per document (Dive, Apogee) and keeps the
# best 15-20 by code. Off by default: ~20% more cost and a little more latency for more
# Prompts and page coverage (docs/architecture/game-generation-pipeline.md § F17).
GEMINI_OVERGENERATE=
# Optional (F30): Dive and Apogee send each document as two Gemini calls in parallel (Open
# Prompts, and every other kind), so a Game waits for the slower half instead of one long call.
# On by default; "off" sends one call per document (§ Split generation (F30)).
GEMINI_SPLIT=

# Dev-only auth bypass: with this set, `next dev` treats every request as this Player (a Clerk user id)
# without signing in. Ignored unless NODE_ENV=development. Never set it in a deployed environment.
# DEV_PLAYER_ID=

# Daily Dive share text (F23): the public site URL; falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Optional (F14): folder holding the eval decks listed in eval/decks.json, for
# npm run generate:eval. Defaults to eval/decks/ (gitignored). Course files never go in git.
EVAL_DECKS_DIR=

# Sonar, the study coach (F32): docs/architecture/sonar.md
# LangGraph needs no key of its own. The coach is Claude Sonnet 5.5 through the LangSmith LLM Gateway:
# store your Anthropic key once in LangSmith (Settings → Provider Secrets), then the app only needs
# LANGSMITH_API_KEY (a workspace-scoped key: Settings → API Keys). Without it, Sonar uses Gemini.
# Optional: the coach model. Default anthropic/claude-sonnet-5-5 (via the gateway); "claude-…" calls
# Anthropic directly with ANTHROPIC_API_KEY; any other name is a Gemini model. Gemini is always the fallback.
SONAR_MODEL=
LANGSMITH_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: LangSmith tracing, so every Sonar turn (observe → coach → tools) shows up at smith.langchain.com.
LANGSMITH_TRACING=
LANGSMITH_PROJECT=syllabyss-sonar
