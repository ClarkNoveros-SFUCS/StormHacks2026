{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-sync.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing team status"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:migrate:*)",
      "Bash(npm run test:db)",
      "Bash(npm run test:db:*)",
      "Bash(npm run generate:check:*)"
    ]
  }
}
